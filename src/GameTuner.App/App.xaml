<?xml version="1.0" encoding="utf-8"?>
<!--
    GameTuner theme: black background, red primary accent, blue secondary accent, white text.

    How the recolouring works: every WinUI control takes its colours from named
    theme resources (e.g. a ToggleSwitch that is "on" uses AccentFillColorDefaultBrush).
    Resources defined HERE are found before the ones in XamlControlsResources, so
    redefining a name re-colours every control that uses it — no control templates
    need to be copied. The app is forced to the dark theme (RequestedTheme="Dark").
-->
<Application
    x:Class="GameTuner.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                The XAML compiler requires the dictionary's property elements
                (MergedDictionaries, ThemeDictionaries) to come together, BEFORE the
                plain resources; splitting the plain resources around them is error WMC0035.
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <!-- Accent (buttons, toggles, checkboxes, progress, selection) -->
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FFE63946" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E6E63946" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CCE63946" />
                    <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#FF3A3A44" />
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FFFF5A67" />
                    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#FFFF8A93" />
                    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#FFFF5A67" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#E6FFFFFF" />

                    <!-- Text -->
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FFB4B4C2" />
                    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF7C7C8C" />

                    <!-- Surfaces -->
                    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#FF000000" />
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FF000000" />
                    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#FF1C1C25" />
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#FF262631" />
                    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#FF22222C" />
                    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#FF000000" />

                    <!-- Inputs and plain buttons -->
                    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FF1C1C25" />
                    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#FF25252F" />
                    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#FF16161D" />
                    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#FF2E2E3A" />
                    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#FF3A3A48" />
                    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#FF1C1C25" />
                    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#FF16161D" />

                    <!-- Status colours: info = blue -->
                    <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="#FF3A86FF" />
                    <SolidColorBrush x:Key="SystemFillColorAttentionBackgroundBrush" Color="#FF13213A" />
                    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#FFFF5A67" />
                    <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="#FF3A1418" />

                    <!-- Navigation pane -->
                    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#FF000000" />
                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#FF000000" />
                    <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="#FF000000" />
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#FF000000" />
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#FF000000" />
                    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#FFE63946" />

                    <!-- Expanders -->
                    <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="#FF000000" />
                    <SolidColorBrush x:Key="ExpanderContentBackground" Color="#FF000000" />
                    <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="#59FFFFFF" />
                    <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="#59FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- ============ Palette ============ -->
            <Color x:Key="GtBlack">#FF000000</Color>
            <Color x:Key="GtPane">#FF0D0D12</Color>
            <Color x:Key="GtSurface">#FF14141B</Color>
            <Color x:Key="GtSurfaceRaised">#FF1C1C25</Color>
            <Color x:Key="GtBorder">#FF262631</Color>
            <Color x:Key="GtRed">#FFE63946</Color>
            <Color x:Key="GtRedLight">#FFFF5A67</Color>
            <Color x:Key="GtRedDark">#FFB3202D</Color>
            <Color x:Key="GtBlue">#FF3A86FF</Color>
            <Color x:Key="GtBlueLight">#FF6EA8FF</Color>
            <Color x:Key="GtWhite">#FFFFFFFF</Color>
            <Color x:Key="GtTextSecondary">#FFB4B4C2</Color>
            <Color x:Key="GtTextTertiary">#FF7C7C8C</Color>

            <SolidColorBrush x:Key="GtRedBrush" Color="{StaticResource GtRed}" />
            <SolidColorBrush x:Key="GtBlueBrush" Color="{StaticResource GtBlue}" />
            <SolidColorBrush x:Key="GtWhiteBrush" Color="{StaticResource GtWhite}" />
            <SolidColorBrush x:Key="GtBlackBrush" Color="{StaticResource GtBlack}" />
            <SolidColorBrush x:Key="GtSurfaceBrush" Color="{StaticResource GtSurface}" />
            <SolidColorBrush x:Key="GtBorderBrush" Color="{StaticResource GtBorder}" />
            <!-- The 2 px white outline around every card ("glow"). Slightly below full white so it isn't harsh. -->
            <SolidColorBrush x:Key="GtCardOutlineBrush" Color="#E6FFFFFF" />

            <!-- System accent colour → red (used by many controls through these names). -->
            <Color x:Key="SystemAccentColor">#FFE63946</Color>
            <Color x:Key="SystemAccentColorLight1">#FFEE5A65</Color>
            <Color x:Key="SystemAccentColorLight2">#FFFF5A67</Color>
            <Color x:Key="SystemAccentColorLight3">#FFFF8A93</Color>
            <Color x:Key="SystemAccentColorDark1">#FFC92E3B</Color>
            <Color x:Key="SystemAccentColorDark2">#FFB3202D</Color>
            <Color x:Key="SystemAccentColorDark3">#FF8C1520</Color>


            <!-- ============ Styles ============ -->

            <!-- A card: the main building block of every page. -->
            <!-- StaticResource (not ThemeResource) on purpose: the look is fixed, it never follows the Windows theme. -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource GtBlackBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource GtCardOutlineBrush}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="18" />
            </Style>

            <!-- Small caption above a big number in the live tiles. -->
            <Style x:Key="TileCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <!-- Big numbers: Bahnschrift (ships with Windows) gives a sporty, "dashboard" look. -->
            <Style x:Key="TileValueStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="FontFamily" Value="Bahnschrift" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,2,0,2" />
            </Style>

            <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleLargeTextBlockStyle}">
                <Setter Property="FontFamily" Value="Bahnschrift" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="20" />
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
                <Setter Property="FontFamily" Value="Bahnschrift" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
