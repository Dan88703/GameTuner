<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GameTuner.App.Views.ChartsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GameTuner.App.Controls">

    <ScrollViewer>
        <StackPanel Padding="32,24,32,32" Spacing="16" MaxWidth="1200">

            <TextBlock Text="Графики" Style="{StaticResource PageTitleStyle}" />

            <!-- What to show -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <ComboBox Header="Данные" MinWidth="320"
                              ItemsSource="{x:Bind ViewModel.SourceOptions}"
                              SelectedIndex="{x:Bind ViewModel.SelectedSourceIndex, Mode=TwoWay}" />
                    <ComboBox Header="Период" MinWidth="160"
                              ItemsSource="{x:Bind ViewModel.RangeOptions}"
                              SelectedIndex="{x:Bind ViewModel.SelectedRangeIndex, Mode=TwoWay}"
                              IsEnabled="{x:Bind ViewModel.IsLive, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- Load -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Нагрузка" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.LoadSummary, Mode=OneWay}" Style="{StaticResource TileCaptionStyle}" TextWrapping="Wrap" />
                    <controls:LineChart Height="240" Data="{x:Bind ViewModel.LoadChart, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- Temperature -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Температура" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.TempSummary, Mode=OneWay}" Style="{StaticResource TileCaptionStyle}" TextWrapping="Wrap" />
                    <controls:LineChart Height="240" Data="{x:Bind ViewModel.TempChart, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- FPS -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="FPS" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.FpsSummary, Mode=OneWay}" Style="{StaticResource TileCaptionStyle}" TextWrapping="Wrap" />
                    <controls:LineChart Height="240" Data="{x:Bind ViewModel.FpsChart, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource TileCaptionStyle}" TextWrapping="Wrap"
                       Text="Графики прошлых сессий сохраняются автоматически для игр дольше минуты. Хранятся последние 50 сессий." />
        </StackPanel>
    </ScrollViewer>
</Page>
