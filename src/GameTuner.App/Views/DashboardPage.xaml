<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GameTuner.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:GameTuner.App.ViewModels">

    <ScrollViewer>
        <StackPanel Padding="32,24,32,32" Spacing="16" MaxWidth="1200">

            <TextBlock Text="Обзор" Style="{StaticResource PageTitleStyle}" />

            <InfoBar
                IsOpen="{x:Bind ViewModel.ShowAdminHint}"
                Severity="Informational"
                Title="Температуры и FPS"
                Message="Для датчиков температуры, частот и счётчика FPS нужен режим администратора.">
                <InfoBar.ActionButton>
                    <Button Content="Перезапустить от администратора" Command="{x:Bind ViewModel.RestartAsAdminCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Active game -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE7FC;" FontSize="36" VerticalAlignment="Center"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.GameTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.GameSubtitle, Mode=OneWay}" Style="{StaticResource TileCaptionStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Visibility="{x:Bind ViewModel.IsGameRunning, Mode=OneWay}">
                        <TextBlock Text="FPS" Style="{StaticResource TileCaptionStyle}" HorizontalAlignment="Right" />
                        <TextBlock Text="{x:Bind ViewModel.FpsText, Mode=OneWay}" Style="{StaticResource TitleLargeTextBlockStyle}" HorizontalAlignment="Right" />
                        <TextBlock Text="{x:Bind ViewModel.FpsLowText, Mode=OneWay}" Style="{StaticResource TileCaptionStyle}" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Live tiles -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Процессор" Style="{StaticResource TileCaptionStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.CpuLoadText, Mode=OneWay}" Style="{StaticResource TileValueStyle}" />
                        <ProgressBar Value="{x:Bind ViewModel.CpuLoad, Mode=OneWay}" Maximum="100" Margin="0,4,0,8" />
                        <TextBlock Text="{x:Bind ViewModel.CpuDetailsText, Mode=OneWay}" Style="{StaticResource TileCaptionStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Видеокарта" Style="{StaticResource TileCaptionStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.GpuLoadText, Mode=OneWay}" Style="{StaticResource TileValueStyle}" />
                        <ProgressBar Value="{x:Bind ViewModel.GpuLoad, Mode=OneWay}" Maximum="100" Margin="0,4,0,8" />
                        <TextBlock Text="{x:Bind ViewModel.GpuDetailsText, Mode=OneWay}" Style="{StaticResource TileCaptionStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Память" Style="{StaticResource TileCaptionStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.RamLoadText, Mode=OneWay}" Style="{StaticResource TileValueStyle}" />
                        <ProgressBar Value="{x:Bind ViewModel.RamPercent, Mode=OneWay}" Maximum="100" Margin="0,4,0,8" />
                        <TextBlock Text="{x:Bind ViewModel.RamDetailsText, Mode=OneWay}" Style="{StaticResource TileCaptionStyle}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Питание" Style="{StaticResource TileCaptionStyle}" />
                        <FontIcon Glyph="&#xE83F;" FontSize="28" HorizontalAlignment="Left" Margin="0,6,0,10" />
                        <TextBlock Text="{x:Bind ViewModel.PowerText, Mode=OneWay}" TextWrapping="Wrap" />
                        <InfoBar IsOpen="{x:Bind ViewModel.IsOnBattery, Mode=OneWay}" IsClosable="False"
                                 Severity="Warning" Message="От батареи ноутбук режет частоты" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Hardware -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="{x:Bind ViewModel.TierText, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Grid ColumnSpacing="24" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Устройство" Style="{StaticResource TileCaptionStyle}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.DeviceText, Mode=OneWay}" />
                        <TextBlock Grid.Row="1" Text="Процессор" Style="{StaticResource TileCaptionStyle}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.CpuName, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="2" Text="Видеокарта" Style="{StaticResource TileCaptionStyle}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.GpuName, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="3" Text="Память" Style="{StaticResource TileCaptionStyle}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.RamText, Mode=OneWay}" />
                        <TextBlock Grid.Row="4" Text="Системный диск" Style="{StaticResource TileCaptionStyle}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.DiskText, Mode=OneWay}" />
                        <TextBlock Grid.Row="5" Text="Экран" Style="{StaticResource TileCaptionStyle}" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Bind ViewModel.ScreenText, Mode=OneWay}" />
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.ScoresText, Mode=OneWay}" Style="{StaticResource TileCaptionStyle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Notes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Message="{x:Bind}" Margin="0,4,0,0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Sessions -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Последние игровые сессии" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Пока пусто. Сессия появится здесь после игры дольше минуты."
                               Style="{StaticResource TileCaptionStyle}"
                               Visibility="{x:Bind ViewModel.HasNoSessions, Mode=OneWay}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Sessions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SessionRow">
                                <Grid ColumnSpacing="16" Padding="0,8" BorderThickness="0,0,0,1"
                                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Game}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind When}" Style="{StaticResource TileCaptionStyle}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Duration}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Fps}" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind Temps}" Style="{StaticResource TileCaptionStyle}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
