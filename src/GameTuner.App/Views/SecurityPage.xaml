<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GameTuner.App.Views.SecurityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:GameTuner.App.ViewModels">

    <ScrollViewer>
        <StackPanel Padding="32,24,32,32" Spacing="16" MaxWidth="1200">

            <TextBlock Text="Безопасность" Style="{StaticResource PageTitleStyle}" />

            <InfoBar IsOpen="{x:Bind ViewModel.ShowAdminHint}" IsClosable="True" Severity="Informational"
                     Title="Нужен режим администратора"
                     Message="Проверка на вирусы, обновление баз, удаление угроз и изменение автозагрузки для всех пользователей работают только от администратора.">
                <InfoBar.ActionButton>
                    <Button Content="Перезапустить от администратора" Command="{x:Bind ViewModel.RestartAsAdminCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Antivirus -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Защита от вирусов" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <InfoBar IsOpen="True" IsClosable="False"
                             Severity="{x:Bind ViewModel.ProtectionSeverity, Mode=OneWay}"
                             Title="{x:Bind ViewModel.ProtectionTitle, Mode=OneWay}"
                             Message="{x:Bind ViewModel.ProtectionDetail, Mode=OneWay}" />
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource TileCaptionStyle}"
                               Text="Проверку и удаление выполняет Microsoft Defender — антивирус, встроенный в Windows, с ежедневно обновляемыми базами. GameTuner сам ничего не считает вирусом и не удаляет." />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Обновить базы" Command="{x:Bind ViewModel.UpdateSignaturesCommand}" />
                        <Button Content="Быстрая проверка" Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.QuickScanCommand}" />
                        <Button Content="Полная проверка" Command="{x:Bind ViewModel.FullScanCommand}" />
                        <Button Content="Стоп" Command="{x:Bind ViewModel.CancelCommand}"
                                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                        <HyperlinkButton Content="Безопасность Windows" Command="{x:Bind ViewModel.OpenWindowsSecurityCommand}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="20" Height="20" />
                        <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Threats -->
                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasThreats, Mode=OneWay}">
                        <TextBlock Text="Найденные угрозы" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Threats}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ThreatRow">
                                    <StackPanel Padding="0,6" BorderThickness="0,0,0,1"
                                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" IsTextSelectionEnabled="True" />
                                        <TextBlock Text="{x:Bind Details}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                   Style="{StaticResource TileCaptionStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Удалить угрозы" Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.RemoveThreatsCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Startup -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <Grid>
                        <TextBlock Text="Автозагрузка" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <Button Content="Обновить" HorizontalAlignment="Right" Command="{x:Bind ViewModel.RefreshStartupCommand}" />
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.StartupSummary, Mode=OneWay}" />
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource TileCaptionStyle}"
                               Text="Выключение работает как в Диспетчере задач: запись не удаляется, её можно включить обратно в любой момент. Отметки ⚠ — повод присмотреться, а не приговор: незнакомое отключи и посмотри, ничего ли не сломалось." />

                    <ItemsControl ItemsSource="{x:Bind ViewModel.StartupItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:StartupItemViewModel">
                                <Grid ColumnSpacing="16" Padding="0,10" BorderThickness="0,0,0,1"
                                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE7BA;" FontSize="14" Visibility="{x:Bind IsSuspicious}"
                                                      Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Publisher}" Style="{StaticResource TileCaptionStyle}" />
                                        <TextBlock Text="{x:Bind Path}" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                                        <TextBlock Text="{x:Bind Findings}" Visibility="{x:Bind HasFindings}" TextWrapping="Wrap"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsOn="{x:Bind IsEnabled, Mode=TwoWay}" IsEnabled="{x:Bind CanToggle}"
                                                  OnContent="Вкл." OffContent="Выкл." VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
